# --- Data --------------------------------------------------------------
# IPUMS extracts are governed by the IPUMS terms of use and MUST NOT be
# redistributed. Keep all raw and processed data out of the repository.
data/raw/*
data/processed/*
# ...but keep the folders and their instructions tracked:
!data/raw/README.md
!data/processed/.gitkeep

# --- Rendered outputs (regenerated by running the notebooks) -----------
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# Quarto / knitr render products
*_files/
*.html
/.quarto/
analysis/*.html

# --- R session cruft ---------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.rds

# renv library (tracked via renv.lock instead)
renv/library/
renv/staging/

# OS files
.DS_Store
Thumbs.db

# --- Rendered Quarto site (published via GitHub Pages) -----------------
# The site is built into docs/. The *.html rule above would otherwise
# exclude it, so re-include everything under docs/. (Negations must come
# after the rules they override, i.e. at the end of this file.)
!docs/
!docs/**
